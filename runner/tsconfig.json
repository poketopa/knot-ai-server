{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@meeting-stt/core/*": [
        "src/core/*"
      ],
      "@shared/types": [
        "src/core/types.ts"
      ]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "src/**/*.ts"
  ]
}
